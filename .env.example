# =============================================================================
# JP Studio Portfolio — Variáveis de Ambiente
# =============================================================================
# Copie este arquivo para .env.local e preencha com suas credenciais
# NUNCA commite .env.local (está no .gitignore)
# =============================================================================

# -----------------------------------------------------------------------------
# SUPABASE (PostgreSQL + Auth + Storage)
# -----------------------------------------------------------------------------
# 1. Crie projeto em https://supabase.com/dashboard
# 2. Settings > API > Project URL + anon/public key
# 3. SQL Editor > rode o script em docs/supabase-schema.sql
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-aqui

# -----------------------------------------------------------------------------
# CLOUDFLARE R2 (Assets pesados: GLB, MP4, HDRI, imagens)
# -----------------------------------------------------------------------------
# 1. Cloudflare Dashboard > R2 > Create bucket "portfolio-assets"
# 2. Settings > Custom domain > adicione cdn.seudominio.com (opcional)
# 3. Bucket > Settings > Public access > "Allow public read"
# 4. Workers > KV/R2 Binding se quiser signed URLs (futuro)
# URL pública do bucket (custom domain ou *.r2.dev)
VITE_R2_PUBLIC_URL=https://cdn.seudominio.com
# Ou se não tiver custom domain: https://pub-xxxxx.r2.dev

# -----------------------------------------------------------------------------
# ASSETS LOCAIS (HDRI, textures, fallbacks) — servidos pelo Vite/Vercel
# -----------------------------------------------------------------------------
# HDRI do Poly Haven: https://polyhaven.com/hdris -> "Studio Small" 2k
# Coloque em public/portfolio/hdri/studio_soft_2k.hdr
VITE_PORTFOLIO_HDRI_URL=/portfolio/hdri/studio_soft_2k.hdr
VITE_PORTFOLIO_ASSET_BASE=/portfolio/

# -----------------------------------------------------------------------------
# OPCIONAL: Analytics / Monitoring
# -----------------------------------------------------------------------------
# VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
# VITE_SENTRY_DSN=https://xxx@sentry.io/xxx